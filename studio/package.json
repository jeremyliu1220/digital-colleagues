    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
